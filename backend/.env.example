# ===== 服务端口 =====
PORT=8080

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rjdj
DB_PASSWORD=rjdj_pass
DB_NAME=rjdj
# 可选：完整 DSN，设置后覆盖上面分项
# DB_DSN=rjdj:rjdj_pass@tcp(127.0.0.1:3306)/rjdj?charset=utf8mb4&parseTime=True&loc=Local

# ===== 安全 =====
# 建议修改为自定义随机字符串
JWT_SECRET=okx-analytics-change-me-secret-9f2c8d1a7b6e
# 用于加密 OKX 密钥（务必修改为自定义值！）
ENCRYPT_KEY=okx-analytics-enc-key-32b-7f3a!@#

# ===== 跨域（逗号分隔，前端经 nginx 反代时一般无需改） =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost

# ===== 大模型（OpenAI 兼容） =====
# 可选：openai / deepseek / moonshot / dashscope / 本地等
LLM_PROVIDER=openai
# base_url 或完整 endpoint。DeepSeek 示例：https://api.deepseek.com
# OpenAI 示例：https://api.openai.com/v1
LLM_BASE_URL=
# 填入你的模型 API Key
LLM_API_KEY=
# 模型名，如 deepseek-chat / gpt-4o-mini
LLM_MODEL=

# ===== 前端静态目录（可选，用于单端口部署打包产物） =====
# STATIC_DIR=../frontend/dist
