{
  // ===================== OKX 接口凭证 =====================
  // 强烈建议只申请「读取」权限的 API Key，不要勾选交易与提现权限。
  // 凭证也可以改用环境变量提供，避免明文落盘：
  //   OKX_API_KEY / OKX_API_SECRET / OKX_PASSPHRASE / OKX_BASE_URL / OKX_SIMULATED
  "okx": {
    "api_key": "ee99c867-38e9-41ee-99ca-c9e4b13afbfe",
    "api_secret": "2600DA91948A6286ECDA343B884B90D5",
    "passphrase": "Cyl@0220",
    // true 表示模拟盘（会带上 x-simulated-trading 请求头）
    "simulated": false,
    // 留空使用官方域名 https://www.okx.com，也可填自建代理域名
    "base_url": "https://www.okx.com",
    // true 表示完全不请求接口，用内置演示数据渲染界面（先调外观时很有用）
    "mock": false
  },

  // ===================== 界面外观 =====================
  "ui": {
    // 窗口标题，按电脑上常见的监控工具来写即可
    "title": "任务管理器",
    // 数据刷新间隔（毫秒），不建议低于 1000，OKX 有频次限制
    "refresh_ms": 3000,
    // dark | light
    "theme": "dark",
    // 标题栏右侧显示的主机名，留空自动取本机名
    "hostname": "",
    // 性能页展示的处理器型号（纯装饰，填写本机真实型号更可信）
    "cpu_name": "Intel(R) Core(TM) i7-10700 CPU @ 2.90GHz",
    "core_count": 8,
    // 性能页展示的物理内存总量，单位 GB（纯装饰，填本机真实内存更可信）。
    // 「内存」列 1:1 等于保证金(MB)，这里要能装下所有持仓保证金之和。
    "mem_total_gb": 16,
    // 额外混入多少条纯装饰的系统进程（System / svchost.exe 之类），让列表更真实
    "decoy_count": 8,
    // 是否提供「详细信息」页签。该页会显示真实标的与盈亏，按 q 前后请留意
    "show_detail": true,
    // 启动时停在哪一页：processes | performance | detail
    "default_tab": "processes"
  },

  // ===================== 伪装映射表 =====================
  // 每条配置把某个标的或某类策略伪装成一条"进程"记录。
  //
  //   name      界面上显示的进程名，随便起，越像系统进程越好
  //   inst_id   对应的 OKX 标的，如 BTC-USDT-SWAP；source 为 grid/dca 等策略类时可留空表示全部
  //   source    数据来源：
  //               position  = 合约持仓
  //               grid      = 网格策略
  //               dca       = 马丁格尔（DCA）
  //               recurring = 定投
  //               signal    = 信号机器人
  //               algo      = 条件单 / 止盈止损
  //               auto      = 以上全部（inst_id 留空则铺满所有数据）
  //   user      「用户名」列显示什么，留空用主机名
  //
  //   映射关系（前五项都是 1:1，界面上那一列的数字就是真实数值本身，不用换算）：
  //   CPU%      = |收益率%|           收益率 3.5%   → CPU 3.5%
  //   内存      = 保证金(U)           保证金 1240   → 内存 1240 MB（超 1024 显示成 GB）
  //   磁盘      = |浮动盈亏(U)|       浮盈 412      → 磁盘 412 MB/s
  //   网络      = |24h涨跌幅%|        涨跌 1.83%    → 网络 1.83 Mbps
  //   GPU%      = 杠杆倍数            10 倍杠杆     → GPU 10%
  //   提交大小  = 最新价 × 0.1        BTC 76926     → 7,693 MB（这一列数字 × 10 是现价）
  //   页面错误  = 持仓均价 × 0.1      均价 78238    → 7,824（同上，用于和现价对照）
  //   电源      = 由 CPU% 自动分级
  //   趋势      = 盈亏方向，红 + 是盈利、绿 - 是亏损（按 d 键可按方向排序）
  //
  //   缩放系数（cpu_scale / mem_scale / disk_scale / net_scale / gpu_scale）
  //   默认全是 1、不用写，只在想让某列整体放大或缩小时才加，例如：
  //     "disk_scale": 0.1    把磁盘列压小（它等于浮动盈亏原值，几百 U 就是几百 MB/s）
  //   「内存」列 1:1 等于保证金，若要它别把性能页顶满，把 mem_total_gb 调到
  //   大于「所有持仓保证金之和 ÷ 1024」即可。
  "processes": [
    { "name": "BTC-cpu", "inst_id": "BTC-USDT-SWAP", "source": "position" },
    { "name": "ETH-cpu2", "inst_id": "ETH-USDT-SWAP", "source": "position" },
    { "name": "nvcontainer", "inst_id": "", "source": "grid" },
    { "name": "WmiPrvSE.exe", "inst_id": "", "source": "dca" },
    { "name": "SearchIndexer.exe", "inst_id": "", "source": "recurring" },
    // 兜底：把上面没点名覆盖到的数据自动铺出来，名字从系统进程名池里取
    { "name": "", "inst_id": "", "source": "auto" }
  ]
}
