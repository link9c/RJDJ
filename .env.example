# 复制为 .env 后按需修改：cp .env.example .env

# ===== 对外端口 =====
APP_PORT=8077
TZ=Asia/Shanghai

# ===== 跨域来源 =====
# * 表示放行所有来源（回显 Origin），局域网用 IP/主机名访问时用；
# 也可指定精确白名单，逗号分隔，如 http://192.168.1.10:8077,http://localhost:8077
CORS_ORIGINS=*

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=rjdj_root
MYSQL_DATABASE=rjdj
MYSQL_USER=rjdj
MYSQL_PASSWORD=rjdj_pass

# ===== 安全（生产环境务必修改） =====
JWT_SECRET=okx-analytics-change-me-secret-9f2c8d1a7b6e
ENCRYPT_KEY=okx-analytics-enc-key-32b-7f3a!@#

# ===== 大模型（可选，也可在网页「系统设置」里配置） =====
LLM_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
